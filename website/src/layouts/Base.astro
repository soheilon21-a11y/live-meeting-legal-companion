---
import '../styles/global.css';

const { t, lang } = Astro.props;
const favicon = `${import.meta.env.BASE_URL}/favicon.svg`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    />
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{t.meta.title}</title>
  </head>
  <body>
    <header class="site-header">
      <p class="notice">{t.notice.v1InDevelopment}</p>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <a class="repo-link" href={t.links.githubUrl} rel="noopener noreferrer">{t.links.github}</a>
      <p class="privacy-note">{t.footer.privacy}</p>
      <p class="copyright">{t.footer.copyright}</p>
    </footer>
  </body>
</html>
