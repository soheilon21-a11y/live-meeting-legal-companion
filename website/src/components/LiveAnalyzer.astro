---
import LiveMeeting from './LiveMeeting.astro';

const { t } = Astro.props;
const scriptSrc = `${import.meta.env.BASE_URL}/live.js`;
---

<section
  class="live"
  data-draft-label={t.live.draftLabel}
  data-verbatim-label={t.live.finding.verbatimLabel}
  data-issue-label={t.live.finding.issueLabel}
  data-evidence-label={t.live.finding.evidenceLabel}
  data-suggested-label={t.live.finding.suggestedQuestionLabel}
  data-ev-supported={t.live.finding.evidence.supported}
  data-ev-conflicting={t.live.finding.evidence.conflicting}
  data-ev-insufficient={t.live.finding.evidence.insufficient}
  data-session-empty={t.live.session.empty}
  data-uploading={t.live.uploading}
  data-doc-ready={t.live.documentReady}
  data-upload-first={t.live.uploadFirst}
  data-analyzing={t.live.analyzing}
  data-err-upload={t.live.error.upload}
  data-err-analyze={t.live.error.analyze}
  data-delete-confirm={t.live.deleteConfirm}
  data-source-label={t.live.consent.sourceLabel}
  data-country-disclaimer={t.live.consent.disclaimer}
  data-consent-no-session={t.live.consent.noSession}
  data-consent-recorded={t.live.consent.consentRecorded}
  data-err-generic={t.live.error.generic}
  data-transcribing={t.live.audio.transcribing}
  data-transcript-empty={t.live.audio.transcriptEmpty}
  data-copied={t.live.audio.copied}
  data-err-consent={t.live.audio.errConsent}
  data-err-transcribe={t.live.audio.errTranscribe}
  data-err-transcript={t.live.audio.errTranscript}
  data-obs-auto-label={t.live.observations.autoLabel}
  data-obs-dismiss={t.live.observations.dismiss}
  data-obs-empty={t.live.observations.empty}
  data-obs-excerpt-label={t.live.observations.excerptLabel}
  data-diarize-button={t.live.diarization.button}
  data-diarize-summary={t.live.diarization.summary}
  data-diarize-speaker={t.live.diarization.speaker}
  data-diarize-unknown={t.live.diarization.unknown}
  data-diarize-error={t.live.diarization.error}
  data-diarize-approximate={t.live.diarization.approximate}
>
  <h1>{t.live.title}</h1>
  <p class="live-subtitle">{t.live.subtitle}</p>

  <p class="disclaimer">{t.live.disclaimer}</p>

  <LiveMeeting t={t} />

  <section class="live-observations">
    <h2>{t.live.observations.title}</h2>
    <ul id="live-observations" class="observation-list"></ul>
  </section>

  <section class="live-setup">
    <h2>{t.live.consent.sectionTitle}</h2>

    <label class="live-label" for="live-country">{t.live.consent.countryLabel}</label>
    <select id="live-country">
      <option value="">{t.live.consent.countryPlaceholder}</option>
      <option value="DE">{t.live.consent.countryOption.DE}</option>
      <option value="AT">{t.live.consent.countryOption.AT}</option>
      <option value="CH">{t.live.consent.countryOption.CH}</option>
      <option value="US">{t.live.consent.countryOption.US}</option>
      <option value="UK">{t.live.consent.countryOption.UK}</option>
      <option value="other">{t.live.consent.countryOption.other}</option>
    </select>
    <div id="live-country-info" class="country-info" hidden></div>

    <label class="live-label" for="live-participants">{t.live.consent.participantsLabel}</label>
    <input type="text" id="live-participants" placeholder={t.live.consent.participantsPlaceholder} />

    <label class="consent-check">
      <input type="checkbox" id="live-consent" />
      <span>{t.live.consent.consentCheckbox}</span>
    </label>

    <button type="button" id="live-record-consent" class="live-analyze">{t.live.consent.recordConsent}</button>
    <p id="live-consent-status" class="live-status" role="status"></p>

    <label class="consent-check disable-audio">
      <input type="checkbox" id="live-disable-audio" />
      <span>{t.live.consent.disableAudio}</span>
    </label>
    <p class="live-hint">{t.live.consent.disableAudioHint}</p>

    <div class="responsibility" id="responsibility">
      <h3>{t.responsibility.title}</h3>
      <p>{t.responsibility.text}</p>
    </div>
  </section>

  <div class="live-form">
    <label class="live-label" for="live-file">{t.live.upload.label}</label>
    <input type="file" id="live-file" accept=".pdf,.docx,.txt" />
    <p class="live-hint">{t.live.upload.hint}</p>

    <label class="live-label" for="live-point">{t.live.discussionPoint.label}</label>
    <textarea id="live-point" rows="3" placeholder={t.live.discussionPoint.placeholder}></textarea>

    <button type="button" id="live-analyze" class="live-analyze">{t.live.analyze}</button>
    <p id="live-status" class="live-status" role="status"></p>
  </div>

  <section class="live-audio" id="live-audio-controls">
    <h2>{t.live.audio.sectionTitle}</h2>

    <fieldset class="audio-mode">
      <legend class="live-label">{t.live.audio.modeLabel}</legend>
      <label class="audio-mode-option">
        <input type="radio" name="live-mode" value="dictation" checked />
        <span>{t.live.audio.modeDictation}</span>
        <span class="live-hint">{t.live.audio.modeDictationHint}</span>
      </label>
      <label class="audio-mode-option">
        <input type="radio" name="live-mode" value="full" />
        <span>{t.live.audio.modeFull}</span>
        <span class="live-hint">{t.live.audio.modeFullHint}</span>
      </label>
    </fieldset>

    <label class="live-label" for="live-audio-file">{t.live.audio.fileLabel}</label>
    <input type="file" id="live-audio-file" accept=".wav,.mp3,.m4a" />

    <div class="audio-actions">
      <button type="button" id="live-transcribe" class="live-analyze">{t.live.audio.transcribe}</button>
      <button type="button" id="live-view-transcript" class="live-export">{t.live.audio.viewTranscript}</button>
    </div>
    <p id="live-audio-status" class="live-status" role="status"></p>

    <section id="live-transcript-wrap" hidden>
      <h3>{t.live.audio.transcriptTitle}</h3>
      <div class="diarize-bar">
        <button type="button" id="live-diarize" class="live-export" hidden>{t.live.diarization.button}</button>
        <p id="live-diarize-summary" class="diarize-summary" hidden></p>
        <p id="live-diarize-note" class="live-hint" hidden>{t.live.diarization.approximate}</p>
      </div>
      <ul id="live-transcript" class="transcript-list"></ul>
      <button type="button" id="live-copy-to-point" class="live-export">{t.live.audio.copyToPoint}</button>
    </section>
  </section>

  <section id="live-result"></section>

  <section class="live-session">
    <h2>{t.live.session.title}</h2>
    <ul id="live-findings" class="session-list"></ul>
    <div class="session-actions">
      <button type="button" id="live-export" class="live-export">{t.live.export}</button>
      <button type="button" id="live-delete" class="live-delete">{t.live.delete}</button>
    </div>
  </section>

  <p class="local-note">{t.live.localNote}</p>
</section>

<script is:inline src={scriptSrc}></script>
