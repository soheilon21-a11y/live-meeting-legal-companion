---
const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const liveHref = lang === 'de' ? `${base}/de/live/` : `${base}/live/`;
const emailValue = t.links.emailUrl.replace('mailto:', '');
const linkedinValue = t.links.linkedinUrl.replace(/\/+$/, '').split('/').pop();
const githubValue = t.links.githubProfileUrl.replace(/\/+$/, '').split('/').pop();
---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1>{t.hero.title}</h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
    </div>
    <div class="hero-cta">
      <a class="btn btn-primary" href={t.links.githubUrl} rel="noopener noreferrer">{t.hero.ctaPrimary}</a>
      <a class="btn btn-secondary" href={liveHref}>{t.hero.ctaSecondary}</a>
      <ul class="trust-row">
        <li>{t.hero.trust.localAI}</li>
        <li>{t.hero.trust.bilingual}</li>
        <li>{t.hero.trust.license}</li>
        <li>{t.hero.trust.noCloud}</li>
      </ul>
    </div>
  </div>
</section>

<section class="about" id="about">
  <p class="kicker">{t.about.kicker}</p>
  <h2>{t.about.title}</h2>
  <p class="about-body">{t.about.body1}</p>
  <blockquote class="about-quote">{t.about.body2}</blockquote>
  <div class="responsibility" id="responsibility">
    <h3>{t.responsibility.title}</h3>
    <p>{t.responsibility.text}</p>
  </div>
</section>

<section class="contact" id="contact">
  <p class="kicker">{t.contact.kicker}</p>
  <h2>{t.contact.title}</h2>
  <div class="contact-grid">
    <a class="contact-card" href={t.links.emailUrl}>
      <span class="contact-label">{t.contact.email}</span>
      <span class="contact-value">{emailValue}</span>
    </a>
    <a class="contact-card" href={t.links.linkedinUrl} rel="noopener noreferrer">
      <span class="contact-label">{t.contact.linkedin}</span>
      <span class="contact-value">{linkedinValue}</span>
    </a>
    <a class="contact-card" href={t.links.githubProfileUrl} rel="noopener noreferrer">
      <span class="contact-label">{t.contact.github}</span>
      <span class="contact-value">{githubValue}</span>
    </a>
  </div>
</section>
