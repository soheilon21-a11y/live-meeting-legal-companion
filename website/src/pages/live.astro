---
import Base from '../layouts/Base.astro';
import LiveAnalyzer from '../components/LiveAnalyzer.astro';
import t from '../i18n/en.json';

const csp_extra = "script-src 'self'; connect-src 'self' http://localhost:8002 http://127.0.0.1:8002; media-src 'self' blob:";
---

<Base t={t} lang="en" csp_extra={csp_extra}>
  <LiveAnalyzer t={t} />
</Base>
